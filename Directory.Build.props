<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Ignora avisos de auditoria offline de vulnerabilidade em ambiente sem rede -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    
    <Authors>Thaylon Lopes</Authors>
    <Company>TL Enterprises</Company>
    <Copyright>Copyright © 2026 Thaylon Lopes</Copyright>
    <PackageProjectUrl>https://github.com/thaylonlopes</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thaylonlopes/TL.LiteCore</RepositoryUrl>
  </PropertyGroup>
</Project>
